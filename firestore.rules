
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAllowedAssistantEmail() {
      return signedIn() && (
        request.auth.token.email == 'adelia.clearesta.1705@gmail.com' ||
        request.auth.token.email == 'aronsorimudajp@gmail.com' ||
        request.auth.token.email == 'wipinsmg@gmail.com' ||
        request.auth.token.email == 'naufaldwi1710@gmail.com' ||
        request.auth.token.email == 'naufaldwiy1710@gmail.com'
      );
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasCurrentUserDoc() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAssistant() {
      return hasCurrentUserDoc() &&
        currentUserDoc().data.role == 'assistant';
    }

    function isStudent() {
      return hasCurrentUserDoc() &&
        currentUserDoc().data.role == 'student';
    }

    function sameClassAsCurrentUser(className) {
      return hasCurrentUserDoc() &&
        currentUserDoc().data.className == className;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function sessionExists(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId));
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == 'student' ||
          (
            request.resource.data.role == 'assistant' &&
            (
              request.resource.data.assistantRole == 'asprak' ||
              isAllowedAssistantEmail()
            )
          )
        );

      allow read: if signedIn() && (
        isSelf(userId) ||
        isAssistant()
      );

      allow update: if signedIn() && (
        (
          isSelf(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
        ) || (
          isAssistant()
          && resource.data.role == 'student'
          && request.resource.data.role == resource.data.role
        )
      );

      allow delete: if false;

      // =========================
      // PUSH NOTIFICATION TOKENS
      // SRS-06 - Adelia
      // =========================
      match /pushTokens/{tokenId} {

        allow read: if isSelf(userId) || isAssistant();
        allow delete: if isSelf(userId);

        allow create: if isSelf(userId)
          && request.resource.data.keys().hasAll([
            'token',
            'platform',
            'enabled',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'enabled',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 10
          && request.resource.data.token.size() <= 512
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.enabled is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow update: if isSelf(userId)
          && request.resource.data.keys().hasAll([
            'token',
            'platform',
            'enabled',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'enabled',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.token == resource.data.token
          && request.resource.data.platform == resource.data.platform
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is timestamp;
      }

      // =========================
      // DEVICES
      // =========================
      match /devices/{deviceId} {
        allow read, write: if isSelf(userId);
      }
    }

    // =========================
    // LABORATORIES
    // =========================
    match /laboratories/{laboratoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAssistant();
    }

    // =========================
    // CLASSES
    // =========================
    match /classes/{classId} {
      allow read: if signedIn();

      allow create, update, delete: if isAssistant();
    }

    // =========================
    // SESSIONS
    // =========================
    match /sessions/{sessionId} {
      allow read: if signedIn();

      allow create, update, delete: if isAssistant();
    }

    // =========================
    // ATTENDANCE
    // =========================
    match /attendance/{attendanceId} {
      allow read: if isAssistant() || (
        signedIn() && (
          resource == null ||
          resource.data.studentId == request.auth.uid
        )
      );

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.id == attendanceId
        && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
        && sessionExists(request.resource.data.sessionId)
        && sessionDoc(request.resource.data.sessionId).data.status == 'ACTIVE'
        && !exists(/databases/$(database)/documents/attendance/$(attendanceId));

      allow update, delete: if false;
    }

    // =========================
    // LEAVE REQUESTS
    // =========================
    match /leaveRequests/{leaveId} {
      allow read: if isAssistant() || (
        signedIn() &&
        resource.data.studentId == request.auth.uid
      );

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedByName == null
        && request.resource.data.reviewedAt == null;

      allow update: if isAssistant()
        && resource.data.status == 'PENDING'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.reason == resource.data.reason
        && (
          request.resource.data.status == 'APPROVED' ||
          request.resource.data.status == 'REJECTED'
        );

      allow delete: if false;
    }

    // =========================
    // NOTIFICATION DISPATCHES
    // SRS-06 - Track sent push events to prevent duplicates
    // =========================
    match /notificationDispatches/{dispatchId} {
      allow read: if signedIn();
      allow create, update: if isAssistant();
      allow delete: if false;
    }

    // =========================
    // DEFAULT DENY
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
